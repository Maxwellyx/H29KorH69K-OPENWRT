 #!/bin/sh
 
+# ===== 主机名：按设备树 model 自动设定（本补丁新增）=====
+# 设备树的 model 属性以 \0 结尾，必须先 tr -d 掉；uci-defaults 阶段 ubus
+# 不一定可用，所以直接读 /proc/device-tree/model，不依赖 ubus。
+#   "HINLINK OPC-H69K Board" -> H69K
+#   "HINLINK OPC-H29K Board" -> H29K
+#   "HINLINK OPC-HT2 Board"  -> HT2
+#   "HINLINK F50-PRO Board"  -> F50-PRO
+#   其它                      -> Hinlink
+dt_model=""
+[ -r /proc/device-tree/model ] && dt_model="$(tr -d '\000' < /proc/device-tree/model)"
+case "$dt_model" in
+	*H69K*)	hn="H69K" ;;
+	*H29K*)	hn="H29K" ;;
+	*HT2*)	hn="HT2" ;;
+	*F50-PRO*)	hn="F50-PRO" ;;
+	*)	hn="Hinlink" ;;
+esac
+
 uci -q batch <<-EOF
 	set system.@system[0].timezone='CST-8'
 	set system.@system[0].zonename='Asia/Shanghai'
+	set system.@system[0].hostname='${hn}'
 
 	delete system.ntp.server
 	add_list system.ntp.server='ntp1.aliyun.com'
@@ -12,6 +31,42 @@ uci -q batch <<-EOF
 EOF
 uci commit system
 
+# ===== F50-PRO 专属：WAN 走 eth1 + DNS 重定向 / NAT =====
+# 当前 lede 是 fw4(nftables)，规则写 /etc/nftables.d/*.nft（fw4 自动 include）；
+# 老写法往 /etc/firewall.user 里塞是 fw3 的机制，当前版本不会读。
+if [ "$hn" = "F50-PRO" ]; then
+	uci -q batch <<-EOF
+		set network.wan=interface
+		set network.wan.ifname='eth1'
+		set network.wan.proto='dhcp'
+		set network.wan.auto='1'
+		set network.wan.hostname='5G'
+		set network.wan6=interface
+		set network.wan6.ifname='eth1'
+		set network.wan6.proto='dhcpv6'
+		set network.wan6.extendprefix='1'
+		set network.wan6.extend_prefix='1'
+		set network.wan6.auto='1'
+		set network.wan6.hostname='5G'
+		commit network
+	EOF
+
+	if [ -d /etc/nftables.d ]; then
+		cat > /etc/nftables.d/10-hinlink-dns.nft <<-'NFT'
+			# Hinlink F50-PRO：DNS 重定向 + WAN 出口伪装（fw4/nftables）
+			chain hinlink_dns_redirect {
+				type nat hook prerouting priority dstnat; policy accept;
+				udp dport 53 redirect to :53
+				tcp dport 53 redirect to :53
+			}
+			chain hinlink_wan_masq {
+				type nat hook postrouting priority srcnat; policy accept;
+				oifname "eth1" masquerade
+			}
+		NFT
+	fi
+fi
+
 rm -f /usr/lib/lua/luci/view/admin_status/index/mwan.htm
 rm -f /usr/lib/lua/luci/view/admin_status/index/upnp.htm
 rm -f /usr/lib/lua/luci/view/admin_status/index/ddns.htm
