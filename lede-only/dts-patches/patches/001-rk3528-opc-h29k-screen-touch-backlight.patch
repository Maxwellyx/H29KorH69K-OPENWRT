+
+	/*
+	 * ⚠️ 这个节点**必须**挂在 &pinctrl 底下，而且**不能有 reg 属性**。
+	 *
+	 * pwm_bl.c 是用 backlight_device_register(dev_name(&pdev->dev), ...) 注册的；
+	 * 而 OF 对「没有 reg 的子节点」会用 <父节点名>:<节点名> 拼出 platform device 名，
+	 * 所以 /pinctrl/backlight 这个路径拿到的设备名就是 "pinctrl:backlight"，
+	 * 也就是 /sys/class/backlight/pinctrl:backlight —— tft-display 的亮度页写死了这个路径。
+	 * 把它挪到别的父节点下（或给它加 reg）名字就会变，亮度页立刻失效。
+	 *
+	 * brightness-levels 256 级 ⇒ max_brightness = 255，app 会自己从
+	 * /sys/class/backlight/pinctrl:backlight/max_brightness 读，不用改 app。
+	 */
+	backlight: backlight {
+		pinctrl-names = "backlight";
+		compatible = "pwm-backlight";
+		/* ⚠️ 第 4 个 cell 是 PWM 极性标志，1 = PWM_POLARITY_INVERTED。
+		 *
+		 * 本机背光是**反相**的：写大亮度值反而更暗。厂商原版就是
+		 *   pwms = <&pwm6 0 25000 1>;
+		 * 之前误把它当成「不明含义的字面量 1」改成了 0，结果亮度条整个反了。
+		 *
+		 * 注：本内核的 dt-bindings/pwm/pwm.h 只定义了 PWM_POLARITY_INVERTED，
+		 *     没有 PWM_POLARITY_NORMAL，所以这里直接写字面量。
+		 */
+		pwms = <&pwm6 0 25000 1>;
+		brightness-levels = <
