# H29K Pro 2025 (no battery) + Quectel RM502Q-GL, engineering build.
# Board revision/GC9307+AXS5106 wiring still require on-device verification.
# Every make invocation MUST include DEVTOOLS_SUFFIX=M.
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_hinlink_opc-h29k=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=256
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# Chinese LuCI, firewall and the author's small M application selection.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-modemd-pro=y
CONFIG_PACKAGE_luci-proto-modem-pro=y
CONFIG_PACKAGE_luci-proto-mbim=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-ncm=y
CONFIG_PACKAGE_modemd-pro=y
CONFIG_PACKAGE_modemband=y
CONFIG_MODEM_PRO_QUECTEL=y
# CONFIG_MODEM_PRO_SIMCOM is not set
# CONFIG_MODEM_PRO_FIBOCOM is not set
# CONFIG_MODEM_PRO_MEIG is not set

# RM502Q-GL plus common USB modems: retain QMI, MBIM and Ethernet USB modes.
# Firmware includes drivers only: it does not send USB-mode-changing AT commands.
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# The source device definition requires these screen/touch/Wi-Fi packages.
CONFIG_PACKAGE_video-support=y
CONFIG_PACKAGE_kmod-fb-tft-gc9307=y
CONFIG_PACKAGE_kmod-input-touchscreen-axs5106=y
CONFIG_PACKAGE_kmod-saradc-rockchip=y
CONFIG_PACKAGE_kmod-backlight-pwm=y
CONFIG_PACKAGE_tft-display=y
CONFIG_PACKAGE_kmod-aic8800-sdio=y
CONFIG_PACKAGE_aic8800-sdio-firmware=y
CONFIG_PACKAGE_aic8800-loader=y
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_kmod-aic8800-usb is not set
# CONFIG_PACKAGE_aic8800-usb-firmware is not set

# Avoid the optional Android ADB stack; the integration script records why.
# CONFIG_PACKAGE_adb-enablemodem is not set
# CONFIG_PACKAGE_adb is not set

# No auto-upgrade/remote provisioning or additional large application bundle.
# CONFIG_ALL is not set
# CONFIG_ALL_NONSHARED is not set
# CONFIG_ALL_KMODS is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_luci-app-rustdesk-server is not set
# CONFIG_PACKAGE_luci-app-clamav is not set
# CONFIG_PACKAGE_luci-app-qosify is not set
