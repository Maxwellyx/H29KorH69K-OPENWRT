#!/bin/sh /etc/rc.common
# Local integration replacement for the init script missing from modem-pro
# commit 397e014b4fe4e5c6a5213fcccbf438590f495a05. Run the foreground process
# under procd; its native -config flag selects the installed TOML file.

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/modemd
CONFIG=/etc/modemd/config.toml

start_service() {
        [ -x "$PROG" ] || return 1
        [ -r "$CONFIG" ] || {
                logger -t modemd "Missing readable configuration: $CONFIG"
                return 1
        }

        procd_open_instance
        procd_set_param command "$PROG" -config "$CONFIG"
        procd_set_param file "$CONFIG"
        procd_set_param respawn 3600 5 5
        procd_set_param term_timeout 20
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
}
