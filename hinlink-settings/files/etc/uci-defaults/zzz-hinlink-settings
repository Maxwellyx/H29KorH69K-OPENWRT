#!/bin/sh
#
# Hinlink 设备出厂默认设置
#
# 文件名的 zzz- 前缀是为了排在 OpenWrt 自带的 zzz-default-settings 之后执行
# （uci-defaults 按文件名字典序跑，首次启动后整个目录会被删掉）。
#
# 来源：lede 树 package/daocaoren/lede-patches/001-lean-default-settings.patch
#
# ⚠️ 这段逻辑只能放在 uci-defaults / 包安装脚本里，**不能只放在 postinst**：
#    镜像编译期打包时 postinst 会被 IPKG_INSTROOT 提前 return 掉（预装 rootfs 不跑脚本），
#    只有 uci-defaults 会在设备首次启动时真正执行。

# ===== 主机名：按设备树 model 自动设定 =====
# 设备树的 model 属性以 \0 结尾，必须先 tr -d 掉；uci-defaults 阶段 ubus 不一定 可用，
# 所以直接读 /proc/device-tree/model，不依赖 ubus。
#   "HINLINK OPC-H69K Board" -> H69K
#   "HINLINK OPC-H29K Board" -> H29K
#   "HINLINK OPC-HT2 Board"  -> HT2
#   "HINLINK F50-PRO Board"  -> F50-PRO
#   其它                      -> Hinlink
dt_model=""
[ -r /proc/device-tree/model ] && dt_model="$(tr -d '\000' < /proc/device-tree/model)"
case "$dt_model" in
        *H69K*)         hn="H69K" ;;
        *H29K*)         hn="H29K" ;;
        *HT2*)          hn="HT2" ;;
        *F50-PRO*)      hn="F50-PRO" ;;
        *)              hn="Hinlink" ;;
esac

uci -q batch <<EOF
        set system.@system[0].timezone='CST-8'
        set system.@system[0].zonename='Asia/Shanghai'
        set system.@system[0].hostname='${hn}'

        delete system.ntp.server
        add_list system.ntp.server='ntp1.aliyun.com'
        add_list system.ntp.server='ntp.tencent.com'
        add_list system.ntp.server='ntp.ntsc.ac.cn'
        add_list system.ntp.server='time.apple.com'
EOF
uci commit system

# ===== F50-PRO 专属：WAN 走 eth1 + DNS 重定向 / NAT =====
# 当前是 fw4(nftables)，规则写 /etc/nftables.d/*.nft（fw4 自动 include）；
# 老写法往 /etc/firewall.user 里塞是 fw3 的机制，当前版本不会读。
if [ "$hn" = "F50-PRO" ]; then
        uci -q batch <<EOF
                set network.wan=interface
                set network.wan.ifname='eth1'
                set network.wan.proto='dhcp'
                set network.wan.auto='1'
                set network.wan.hostname='5G'
                set network.wan6=interface
                set network.wan6.ifname='eth1'
                set network.wan6.proto='dhcpv6'
                set network.wan6.extendprefix='1'
                set network.wan6.extend_prefix='1'
                set network.wan6.auto='1'
                set network.wan6.hostname='5G'
                commit network
EOF

        if [ -d /etc/nftables.d ]; then
                cat > /etc/nftables.d/10-hinlink-dns.nft <<'NFT'
                        # Hinlink F50-PRO：DNS 重定向 + WAN 出口伪装（fw4/nftables）
                        chain hinlink_dns_redirect {
                                type nat hook prerouting priority dstnat; policy accept;
                                udp dport 53 redirect to :53
                                tcp dport 53 redirect to :53
                        }
                        chain hinlink_wan_masq {
                                type nat hook postrouting priority srcnat; policy accept;
                                oifname "eth1" masquerade
                        }
NFT
        fi
fi

# ===== 无线默认开启 =====
# mac80211 生成的 /etc/config/wireless 默认带 option disabled '1'
if [ -f /etc/config/wireless ]; then
        sed -i '/^[[:space:]]*option disabled/d' /etc/config/wireless
fi

# ===== root 密码 + 无线 SSID/密码 =====
# 幂等，逻辑和 /etc/init.d/hinlink-defaults 共用同一份脚本：
#   SSID = 上面那个设备树名（hn），加密 psk2，密码 password
#   root 登录密码 = password
# 无线配置此刻还不存在也没关系，init 脚本会在网卡就绪后重试。
[ -x /usr/libexec/hinlink-defaults ] && /usr/libexec/hinlink-defaults

rm -rf /tmp/luci-modulecache/
rm -f /tmp/luci-indexcache

exit 0
