+/*
+ * ---------------------------------------------------------------------------
+ * cfg80211 接口参数兼容层
+ *
+ * openwrt backports <= 6.18.39:
+ *   add_station / del_station / change_station / get_station /
+ *   add_key / get_key / del_key / set_default_mgmt_key
+ *   的“接口”参数是 struct net_device *
+ *
+ * openwrt backports >= 7.2: 全部改成了 struct wireless_dev *
+ *   （为支持 NAN / MLD，见 net/wireless/rdev-ops.h）
+ *      rdev->ops->del_station(&rdev->wiphy, wdev, params);
+ *
+ * 驱动若仍把该指针当 net_device 用，netdev_priv() 会读到错误的内存，
+ * 结果是内核 oops / 看门狗复位。典型现象：
+ *   - hostapd 启动时首次 DEL_STATION（清空所有站点）就崩
+ *   - 客户端一连上（NEW_STATION / SET_STATION）整机复位
+ *
+ * 开关 RWNX_CFG80211_OPS_USE_WDEV 由包 Makefile 依据 mac80211 包版本传入。
+ * ---------------------------------------------------------------------------
+ */
+#ifdef RWNX_CFG80211_OPS_USE_WDEV
+#define RWNX_CFG80211_IFACE_DECL	struct wireless_dev *wdev
+/* 驱动内部自己调用这些回调时，手上是 net_device，需要转回 wdev */
+#define RWNX_CFG80211_IFACE_ARG(dev)	((struct wireless_dev *)((dev) ? (dev)->ieee80211_ptr : NULL))
+#define RWNX_IFACE_DEV(wdev)		((wdev) ? (wdev)->netdev : NULL)
+/* 驱动 -> cfg80211 的通知接口（cfg80211_new_sta / cfg80211_del_sta）同样改成 wdev */
+#define RWNX_CFG80211_NOTIFY_IFACE(vif)	(&(vif)->wdev)
+#else
+#define RWNX_CFG80211_IFACE_DECL	struct net_device *wdev
+#define RWNX_CFG80211_IFACE_ARG(dev)	(dev)
+#define RWNX_IFACE_DEV(wdev)		(wdev)
+#define RWNX_CFG80211_NOTIFY_IFACE(vif)	((vif)->ndev)
+#endif
